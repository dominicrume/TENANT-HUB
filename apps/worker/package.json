{
  "name": "@tenant-hub/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@tenant-hub/adapters": "workspace:*",
    "@tenant-hub/audit": "workspace:*",
    "@tenant-hub/blockchain": "workspace:*",
    "@tenant-hub/db": "workspace:*",
    "@tenant-hub/domain": "workspace:*",
    "@tenant-hub/env": "workspace:*",
    "@tenant-hub/kya": "workspace:*",
    "@tenant-hub/ports": "workspace:*",
    "@tenant-hub/telemetry": "workspace:*",
    "@tenant-hub/validation": "workspace:*",
    "tsx": "4.11.0"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "@types/node": "20.12.12",
    "vitest": "1.6.0",
    "@electric-sql/pglite": "0.5.8"
  }
}
